# canonical / og:url base, defaults to https://raykan.co (nuxt.config site.url)
# NUXT_SITE_URL='https://raykan.co'

# SMTP for the contact form. Mailtrap sandbox for testing:
# host sandbox.smtp.mailtrap.io, port 2525, user/pass from the inbox's SMTP settings
NUXT_MAIL_HOST=''
NUXT_MAIL_PORT=587
NUXT_MAIL_USER=''
NUXT_MAIL_PASS=''
# our own sender, e.g. 'Raykan Website <no-reply@raykan.co>'
NUXT_MAIL_FROM=''
# inbox that receives the messages, defaults to info@raykan.co
# NUXT_MAIL_TO=''

# reCAPTCHA v3 keys for the contact form (https://www.google.com/recaptcha/admin, add localhost for dev)
# without them, local dev skips the check; production requires them
NUXT_PUBLIC_SCRIPTS_GOOGLE_RECAPTCHA_SITE_KEY=''
NUXT_RECAPTCHA_SECRET_KEY=''
# NUXT_RECAPTCHA_MIN_SCORE=0.5

# search engines: production is indexed, set to false on Vercel Preview so test deploys stay out of Google
# NUXT_SITE_INDEXABLE=false
